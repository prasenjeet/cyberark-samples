<!--
  NuGet packages required by CPMRenci-Plugin.ps1
  Run download-sshnet.ps1 to fetch these into the plugin directory.
-->
<packages>
  <!-- SSH.NET by Renci — open-source SSH2 library for .NET -->
  <package id="SSH.NET" version="2024.2.0" targetFramework="net472" />
</packages>
