<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet packages required by CPMRebex-Plugin.ps1
  Run download-rebex.ps1 to fetch these into the plugin directory.
-->
<packages>
  <!-- Rebex SSH core library — handles SSH2 sessions, SCP, key auth, KI auth. -->
  <package id="Rebex.Ssh"    version="2024.1.8631" targetFramework="net472" />

  <!-- Required by Rebex.Ssh — common networking and cryptography primitives. -->
  <package id="Rebex.Common" version="2024.1.8631" targetFramework="net472" />
</packages>
